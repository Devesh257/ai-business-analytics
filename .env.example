# Database
DATABASE_URL=postgresql+psycopg2://analytics:analytics_password@localhost:5433/analytics

# Supported LLM providers:
# gemini
# azure_openai
# mock
LLM_PROVIDER=gemini

# Model used for grounded explanations
LLM_MODEL=gemini-3.6-flash

# Maximum number of ranked insights that may
# automatically call the LLM.
#
# 0 = disable automatic LLM calls
# 3 = only the top three ranked insights
#
# Valid range: 0-10
LLM_AUTO_EXPLANATION_LIMIT=3

# Gemini
GEMINI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Comma-separated frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173

# Application logging
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Authentication
# Generate locally with:
# openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=30

# Login brute-force protection
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

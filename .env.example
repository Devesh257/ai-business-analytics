# Runtime environment: development, test, or production.
# Production configuration is supplied by the deployment environment,
# not committed files.
APP_ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg2://analytics:analytics_password@localhost:5433/analytics

# Supported LLM providers:
# gemini
# azure_openai
# ollama
# mock
LLM_PROVIDER=gemini

# Model used for grounded explanations
LLM_MODEL=gemini-3.6-flash

# Maximum number of ranked insights that may
# automatically call the LLM.
#
# 0 = disable automatic LLM calls
# 3 = only the top three ranked insights
#
# Valid range: 0-10
LLM_AUTO_EXPLANATION_LIMIT=3

# Gemini
GEMINI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Ollama
# Example for a private LAN inference server:
# OLLAMA_BASE_URL=http://192.168.1.7:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# Comma-separated, explicit frontend origins. Wildcards, paths, and
# credentials are rejected. Production origins must use HTTPS.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Application logging
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Authentication
# Generate locally with:
# openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=30

# Login brute-force protection
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# Dataset storage
# Local storage is for development/test only.
# Production requires STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=backend/storage

# S3-compatible production storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_PREFIX=datasets
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_ENDPOINT_URL=
